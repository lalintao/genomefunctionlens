  "hotfix": {
    "issue": "annotation TSV parsing assumed a narrow ID/column format; zero-hit builds could silently publish without matrices; wide matrices used a full pivot",
    "fixes": [
      "zero-hit annotation types fail the build",
      "annotation_hit_counts recorded in manifest",
      "workers>1 rejected above 20,000,000 protein lookup entries",
      "no annotation files fail the build",
      "annotation columns accept tab, space, comma, and pipe separators",
      "GTDB-style protein IDs such as AP022133.1_1553 are supported",
      "wide annotation matrices write row-chunked Parquet without a full pivot",
      "repair and diagnostic tools use the same delimiter rules"
    ]
  },
